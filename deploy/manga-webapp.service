[Unit]
Description=Update Manga webapp (gunicorn)
After=network.target

[Service]
Type=simple
User=www-data
WorkingDirectory=/opt/Update-Manga/webapp
Environment="PATH=/opt/Update-Manga/.venv/bin"
# ใส่ TELEGRAM_TOKEN / TELEGRAM_CHAT_ID ไว้ในไฟล์นี้ (ดู .env.example) อย่าใส่ตรงนี้ตรง ๆ
# เพราะไฟล์ .service มักอ่านได้จากทุก user ในเครื่อง
EnvironmentFile=-/opt/Update-Manga/.env
ExecStart=/opt/Update-Manga/.venv/bin/gunicorn -w 2 -b 127.0.0.1:5050 app:app
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target
